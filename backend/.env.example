# Backend environment variables
# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# Port for the backend API server
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Allowed frontend origin (CORS)
FRONTEND_URL=http://localhost:5173

# --- MySQL (configured in Phase 10) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=personal_portfolio

# --- Auth (configured in a later phase) ---
# JWT_SECRET=replace_with_a_long_random_string